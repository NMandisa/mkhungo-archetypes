<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor
        xmlns="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0
                           http://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd"
        name="custom-archetype">

    <requiredProperties>
        <requiredProperty key="groupId">
            <defaultValue>za.co.example</defaultValue>
            <validationRegex>^[a-z][a-z0-9_]*(\.[a-z0-9_]+)+[0-9a-z_]$</validationRegex>
        </requiredProperty>
        <requiredProperty key="artifactId">
            <defaultValue>demo-dummy</defaultValue>
            <validationRegex>^[a-z]+(-[a-z0-9]+)*$</validationRegex>
        </requiredProperty>
        <requiredProperty key="version">
            <defaultValue>0.0.1-SNAPSHOT</defaultValue>
            <validationRegex>^\d+\.\d+\.\d+(-[A-Z]+)?$</validationRegex>
        </requiredProperty>
    </requiredProperties>

    <fileSets>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>src/main/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" encoding="UTF-8">
            <directory>src/main/resources</directory>
            <includes>
                <include>**/*/*.xml</include>
                <include>**/*.yml</include>
                <include>**/*.properties</include>
                <include>**/*/*.yml</include>
                <include>**/*/*.properties</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>src/test/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>
    </fileSets>
    <!--<modules>
        <module name="sub-module"></module>
    </modules>-->
</archetype-descriptor>